<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quiz_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal"
        android:importantForAccessibility="yes">

        <!-- Header Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            android:backgroundTint="@color/header_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧠 QUIZ INTERAKTIF 🧠"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="yes" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/player_info_bg"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/teksNama"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Nama: Player"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/secondary_text"
                        android:drawableStart="@drawable/ic_person"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="yes" />

                    <TextView
                        android:id="@+id/teksNyawa"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="❤️❤️❤️"
                        android:textSize="20sp"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/lives_bg"
                        android:padding="8dp"
                        android:importantForAccessibility="yes" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Instruction Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            android:backgroundTint="@color/instruction_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_lightbulb"
                    android:layout_marginEnd="12dp"
                    android:tint="@color/accent_color"
                    android:contentDescription="@string/ic_lightbulb_desc" />

                <TextView
                    android:id="@+id/teksInstruksi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Silakan jawab pertanyaan!"
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="@color/instruction_text"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Question Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp"
            android:backgroundTint="@color/question_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:id="@+id/teksSoal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pertanyaan akan muncul di sini..."
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:lineSpacingExtra="4dp"
                    android:gravity="start"
                    android:background="@drawable/question_text_bg"
                    android:padding="16dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Answer Options -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            android:backgroundTint="@color/options_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PILIH JAWABAN"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_color"
                    android:layout_marginBottom="5dp" />

                <RadioGroup
                    android:id="@+id/pilihanJawaban"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Answer Button -->
        <Button
            android:id="@+id/tombolJawab"
            style="@style/PrimaryButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🚀 JAWAB SEKARANG!"
            android:background="@drawable/submit_button_bg"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp" />

        <!-- Progress -->
        <LinearLayout
            android:id="@+id/progressBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

        </LinearLayout>
    </LinearLayout>
</ScrollView>
