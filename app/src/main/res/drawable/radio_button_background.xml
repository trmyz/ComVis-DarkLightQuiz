<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/quiz_answer_selected_color" /> <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/quiz_answer_stroke_selected" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F0F0F0" /> <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#CCCCCC" />
        </shape>
    </item>
</selector>